# genos-api (Django + DRF + Genos/search_engine) — verified from backend_django/** imports.
# Merges the root Pipfile's Django+Genos deps WITH the extras currently pip-installed in
# backend_django/Dockerfile, so there's ONE manifest. `django` is pinned explicitly (today it
# is only pulled transitively via DRF). Boots: collectstatic -> migrate -> opensearch_setup
# -> gunicorn apis.wsgi:application  (preserve this CMD sequence).
#
# Every package is pinned (MIP-750). Bump one with `pipenv upgrade "<pkg>==<version>"`,
# which re-resolves only that package and its dependencies. A bare `pipenv lock` also
# re-resolves every transitive dependency to its newest release.
[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
# --- Django core / web ---
django = "==5.2.18"                         # pin explicitly; was transitive-only before
djangorestframework = "==3.18.3"
djangorestframework-simplejwt = "==5.5.1"
django-cors-headers = "==4.7.0"
dj-database-url = "==3.1.2"
psycopg2-binary = "==2.9.12"
django-redis = "==7.0.0"
whitenoise = "==6.12.0"
gunicorn = "==26.0.0"
requests = "==2.33.1"
cryptography = "==50.0.2"                   # imported directly in backend_django/**
pyyaml = "==6.0.2"
# --- email / push (from Dockerfile pip installs) ---
"django-anymail" = {extras = ["resend"], version = "==15.0"}
pywebpush = "==2.3.0"
# --- Genos / Spotlight (LLM + search) ---
opensearch-py = "==3.0.0"
openai = "==2.5.0"
google-genai = "==2.3.0"
anthropic = "==0.102.0"
tavily-python = "==0.7.26"
# --- Billing ---
stripe = "==15.3.1"
# --- Security floors for transitive deps (pip-audit, MIP-750) ---
# Not imported directly; listed so no lock can resolve below the fixed release.
pyjwt = ">=2.15.0"                          # via djangorestframework-simplejwt
sqlparse = ">=0.6.0"                        # via django
aiohttp = ">=3.14.4"                        # via pywebpush
multidict = "<7,>=6.9.1"                    # via aiohttp; 7.x is a major
urllib3 = ">=2.8.0"                         # via requests, opensearch-py, django-anymail
certifi = ">=2026.10.19"                    # via requests
pyasn1 = ">=0.6.5"                          # via pyasn1-modules, google-auth
# NOTE: `trino` is imported in backend_django/** but absent from the current Pipfile.
# Confirm whether it's actually reachable before adding:  trino = "*"

[dev-packages]

[requires]
python_version = "3.11"
